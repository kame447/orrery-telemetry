#!/usr/bin/env bash
# ChatGPT-facing ORRERY MCP gateway. Loopback only; refuses to start without
# a pairing secret (or explicit OAuth settings). See docs/chatgpt-mcp.md.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
py="${AGENTSTACK_PYTHON:-python3}"
export PYTHONPATH="$here/integrations/chatgpt_mcp/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$py" -m orrery_chatgpt_mcp "$@"
